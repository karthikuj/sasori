{
  "name": "sasori-crawl",
  "version": "2.0.0",
  "description": "Sasori is a dynamic web crawler powered by Puppeteer, designed for lightning-fast endpoint discovery.",
  "main": "dist/bin/index.js",
  "author": "Karthik UJ",
  "license": "MIT",
  "contributors": [
    {
      "name": "Karthik UJ",
      "email": "karthikuj2001@gmail.com",
      "url": "https://www.5up3r541y4n.tech/"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karthikuj/sasori.git"
  },
  "bin": {
    "sasori": "dist/bin/index.js"
  },
  "files": [
    "dist/bin",
    "dist/src",
    "dist/config",
    "dist/package.json",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "cp -r config dist/",
    "dev": "tsc --watch",
    "start": "node dist/bin/index.js",
    "start:dev": "node .",
    "lint": "eslint . --ext .ts,.js --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false"
  },
  "keywords": [
    "crawler",
    "crawling",
    "scraping",
    "endpoint-discovery",
    "puppeteer",
    "dynamic",
    "automation",
    "security",
    "dast",
    "infosec"
  ],
  "dependencies": {
    "@puppeteer/replay": "^4.0.2",
    "chalk": "^4",
    "cheerio": "^1.0.0-rc.12",
    "express": "^5.2.1",
    "joi": "^17.12.2",
    "puppeteer": "^25.18.1",
    "rotating-file-stream": "^3.2.10",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^3.1.0",
    "@types/cheerio": "^0.22.35",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/supertest": "^7.2.0",
    "@types/yargs": "^17.0.33",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
    "jest": "^30.5.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "@jest/reporters": {
      "glob": "^14.0.6"
    },
    "jest-config": {
      "glob": "^14.0.6"
    },
    "jest-runtime": {
      "glob": "^14.0.6"
    },
    "test-exclude": {
      "glob": "^14.0.6",
      "minimatch": "^11.0.9"
    }
  }
}
