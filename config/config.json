{
    "browser": {
        "headless": true,
        "maximize": true,
        "proxy": {
            "enabled": true,
            "host": "127.0.0.1",
            "port": 3200
        },
        "instances": 1
    },
    "crawler": {
        "entryPoint": "https://demo.testfire.net/bank/main.jsp",
        "eventTimeout": 10000,
        "navigationTimeout": 30000,
        "eventWait": 0,
        "debugNetwork": false,
        "maxActionRetries": 3,
        "maxDuration": 0,
        "elements": [
            "a",
            "button",
            "input[type=\"submit\"]",
            "[click]"
        ],
        "maxChildren": 0,
        "maxDepth": 10,
        "authentication": {
            "basicAuth": {
                "enabled": false,
                "username": "username",
                "password": "password"
            },
            "recorderAuth": {
                "enabled": true,
                "pptrRecording": "/home/sup3r541y4n/Dev/sasori-private/coverage/testfire.pptr.json"
            }
        },
        "includeRegexes": [
            "https?://demo.testfire.net(?:/.*|)"
        ],
        "excludeRegexes": [
            ".*logout.*"
        ],
        "extraSeeds": [],
        "sitemap": {
            "enabled": false,
            "maxSeedUrls": 100,
            "maxSitemapDepth": 3,
            "maxSitemapUrls": 5000,
            "respectRobots": true
        }
    },
    "logging": {
        "file": "logs/sasori.log",
        "console": true,
        "maxSizeMB": 100,
        "maxBackups": 20,
        "maxAgeDays": 30,
        "compress": true
    }
}
